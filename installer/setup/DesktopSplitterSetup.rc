// DesktopSplitterSetup.rc
//
// Embeds the signed driver package AND the product files. Everything is staged
// into payload\ by stage-payload.ps1, which runs as a prebuild step and fails
// the build with a clear message if the driver package is missing, its catalog
// is unsigned, or the app could not be published.

#include <windows.h>
#include "resource.h"
// Generated by build.ps1 from the root VERSION file.
#include "Version.h"

// Driver package.
IDR_DRIVER_INF        RCDATA  "payload\\DesktopSplitterVdd.inf"
IDR_DRIVER_DLL        RCDATA  "payload\\DesktopSplitterVdd.dll"
IDR_DRIVER_CAT        RCDATA  "payload\\DesktopSplitterVdd.cat"

// Product files installed into the target directory. DesktopSplitter.exe is a
// self-contained single-file publish, so the target PC needs no .NET runtime.
IDR_APP_EXE           RCDATA  "payload\\DesktopSplitter.exe"
IDR_DSCOMP_EXE        RCDATA  "payload\\dscomp.exe"
IDR_DEVCREATE_EXE     RCDATA  "payload\\devcreate.exe"
IDR_COMPOSITOR_README RCDATA  "payload\\compositor-README.md"
// The app probes for edidoverride.exe next to its own exe first, so this must
// land in the install directory root alongside DesktopSplitter.exe.
IDR_EDIDOVERRIDE_EXE  RCDATA  "payload\\edidoverride.exe"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    DS_VERSION_COMMA
 PRODUCTVERSION DS_VERSION_COMMA
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "DesktopSplitter"
            VALUE "FileDescription",  "DesktopSplitter virtual display driver installer"
            VALUE "FileVersion",      DS_VERSION_STR4
            VALUE "InternalName",     "DesktopSplitterSetup"
            VALUE "LegalCopyright",   "DesktopSplitter"
            VALUE "OriginalFilename", "DesktopSplitterSetup.exe"
            VALUE "ProductName",      "DesktopSplitter"
            VALUE "ProductVersion",   DS_VERSION_STR4
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
