<Application x:Class="DesktopSplitter.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>

            <SolidColorBrush x:Key="WindowBackground" Color="#FF16191F"/>
            <SolidColorBrush x:Key="PanelBackground" Color="#FF1D2129"/>
            <SolidColorBrush x:Key="PanelBorder" Color="#FF303743"/>
            <SolidColorBrush x:Key="ForegroundBrush" Color="#FFE6EAF2"/>
            <SolidColorBrush x:Key="MutedBrush" Color="#FF95A0B4"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#FF4C8DFF"/>
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#FF2A4A82"/>
            <SolidColorBrush x:Key="ErrorBrush" Color="#FFFF7A7A"/>
            <SolidColorBrush x:Key="SegmentFill" Color="#FF4C8DFF"/>
            <SolidColorBrush x:Key="PreviewBackground" Color="#FF10131A"/>

            <!-- FancyZones-like editor canvas -->
            <SolidColorBrush x:Key="CanvasBackground" Color="#FF0C0F14"/>
            <SolidColorBrush x:Key="ZoneFill" Color="#FF25344F"/>
            <SolidColorBrush x:Key="ZoneStroke" Color="#FF4C8DFF"/>
            <SolidColorBrush x:Key="ZoneNumberBrush" Color="#FF9DC0FF"/>
            <SolidColorBrush x:Key="SplitterBrush" Color="#FF5A6478"/>
            <SolidColorBrush x:Key="SplitterHoverBrush" Color="#FF4C8DFF"/>

            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="12.5"/>
            </Style>

            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>

            <Style TargetType="TextBox">
                <Setter Property="Background" Value="#FF11141A"/>
                <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="5,3"/>
                <Setter Property="CaretBrush" Value="{StaticResource ForegroundBrush}"/>
                <Setter Property="FontFamily" Value="Consolas"/>
            </Style>

            <!--
                The implicit TextBlock style above sets a near-white foreground on EVERY
                TextBlock, including the ones WPF generates inside a ComboBox for
                DisplayMemberPath. Against the default (light) ComboBox chrome that rendered
                as white-on-white, i.e. apparently blank items. These templates give the
                ComboBox and its items an explicit dark background so the contrast is
                guaranteed regardless of the system theme.
            -->
            <Style x:Key="ComboToggleButton" TargetType="ToggleButton">
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="ClickMode" Value="Press"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Bd" Background="#FF11141A"
                                    BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"
                                    CornerRadius="4">
                                <Path x:Name="Arrow" HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Margin="0,0,10,0" Data="M 0 0 L 4 4 L 8 0 Z"
                                      Fill="{StaticResource MutedBrush}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#FF181C24"/>
                                    <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource ForegroundBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}" CornerRadius="3">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#FF262C38"/>
                                </Trigger>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ComboBox">
                <Setter Property="Padding" Value="9,6"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
                <Setter Property="Background" Value="#FF11141A"/>
                <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}"/>
                <Setter Property="MinHeight" Value="30"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton Style="{StaticResource ComboToggleButton}"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <ContentPresenter x:Name="ContentSite"
                                                  Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                                  IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                  TextElement.Foreground="{StaticResource ForegroundBrush}"/>
                                <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                       Placement="Bottom" PopupAnimation="Slide"
                                       MinWidth="{TemplateBinding ActualWidth}">
                                    <Border Background="{StaticResource PanelBackground}"
                                            BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"
                                            CornerRadius="4" Margin="0,2,0,0"
                                            MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="3">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="Button">
                <Setter Property="Background" Value="{StaticResource PanelBackground}"/>
                <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="14,6"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#FF272C36"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
