<Window x:Class="DesktopSplitter.Views.CountdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="保留显示更改？"
        Width="620" Height="360"
        WindowStyle="None" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="True"
        WindowStartupLocation="Manual"
        Background="{StaticResource WindowBackground}">

    <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" CornerRadius="6">
        <Grid Margin="28,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="HeadingText" Grid.Row="0" Text="保留这些显示设置？"
                       FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/>

            <TextBlock x:Name="DetailText" Grid.Row="1" Margin="0,10,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource MutedBrush}" FontSize="13"
                       Text="如果看起来有什么不对，或者你看不清楚，请什么都不要做 —— 倒计时归零时，更改会自动撤销。"/>

            <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="CountdownText" Text="10"
                           FontSize="86" FontWeight="Bold" TextAlignment="Center"
                           Foreground="{StaticResource AccentBrush}"/>
                <TextBlock x:Name="CountdownCaption" Text="秒后自动撤销"
                           TextAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="13"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="KeepButton" Content="保留更改"
                        Style="{StaticResource PrimaryButton}"
                        MinWidth="180" Padding="18,12" FontSize="15"
                        Click="Keep_Click"/>
                <Button x:Name="RevertButton" Content="立即撤销"
                        Margin="16,0,0,0" MinWidth="180" Padding="18,12" FontSize="15"
                        Click="Revert_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
