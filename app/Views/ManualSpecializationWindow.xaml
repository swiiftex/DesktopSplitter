<Window x:Class="DesktopSplitter.Views.ManualSpecializationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remove display from desktop"
        Width="660" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="True"
        WindowStartupLocation="Manual"
        Background="{StaticResource WindowBackground}">

    <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" CornerRadius="6">
        <StackPanel Margin="26,22">

            <TextBlock x:Name="HeadingText" Text="Remove the display from the desktop"
                       FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>

            <TextBlock x:Name="ReasonText" Margin="0,10,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource MutedBrush}" FontSize="12.5"/>

            <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="1" CornerRadius="4" Padding="14,12" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="In Windows Settings:" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock x:Name="StepsText" TextWrapping="Wrap" FontSize="12.5" LineHeight="21"/>
                </StackPanel>
            </Border>

            <Border x:Name="StatusBorder" Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                    CornerRadius="4" Padding="14,10" Margin="0,12,0,0">
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="12.5"
                           Foreground="{StaticResource ForegroundBrush}"/>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="OpenSettingsButton" Content="Open display settings"
                        Style="{StaticResource PrimaryButton}" MinWidth="180" Padding="16,9"
                        Click="OpenSettings_Click"/>
                <Button x:Name="CancelButton" Content="Cancel" Margin="10,0,0,0"
                        MinWidth="120" Padding="16,9" Click="Cancel_Click"/>
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
